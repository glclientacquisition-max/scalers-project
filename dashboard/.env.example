# Supabase project (server + browser Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only admin client (desk data + tenant provisioning fallback)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional legacy shared-password desk (ops / demo).
# Prefer Supabase Auth email/password via /signup + /login.
# DASHBOARD_PASSWORD=choose-a-strong-password
# DASHBOARD_SECRET=optional-random-string

# Local only — skip auth when password unset
# DASHBOARD_OPEN=true

# Onboarding + Pronunciation studio (Use this take audio verify)
# Without this key, desk still saves pack targets with a basic local say-as.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override for audio-capable model used by pronunciation verify:
# GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite

# Super Admin telecom panel + DID pool sync (server-only, never NEXT_PUBLIC_*)
# SAUTIKIT_API_KEY=your_sautikit_api_key
# SAUTIKIT_API_BASE=https://api.sautikit.com
# Key B — buy numbers + set routing (numbers.claim). Keep separate from Key A.
# SAUTIKIT_ADMIN_OPS_KEY=your_admin_ops_key
# VOICE_PUBLIC_BASE_URL=https://scalers-project-production.up.railway.app

# One-wallet billing display rates (optional; defaults 15 / 1000)
# WALLET_RATE_KES_PER_MINUTE=15
# WALLET_LINE_FEE_KES_PER_MONTH=1000

# Owner wallet top-up (optional until M-Pesa / Paystack is live)
# WALLET_TOPUP_ENABLED=true
# WALLET_TOPUP_PROVIDER=mpesa
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
# PAYSTACK_SECRET_KEY=
