# Supabase project (server + browser Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server Auth + admin client. Required on Vercel so /api/login does not depend
# on NEXT_PUBLIC_* values inlined at build.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Super Admin (Better Auth). Username + access code. Not email.
# Same Vercel project. Marketing stays on www. Owner desk is the app host.
# Admin host redirects /admin off the marketing site. Leave APP_HOST unset locally.
# ADMIN_HOST=admin.scalers.co.ke
# NEXT_PUBLIC_ADMIN_HOST=admin.scalers.co.ke
# APP_HOST=app.scalers.co.ke
# NEXT_PUBLIC_SITE_URL=https://www.scalers.co.ke
# BETTER_AUTH_SECRET=long-random-string
# Shared door code + usernames:
# ADMIN_ACCESS_CODE=choose-a-strong-code
# ADMIN_USERNAMES=kigen,mercy
# Or per-user codes:
# ADMIN_OPERATORS=kigen:code-one,mercy:code-two

# Optional leftover HMAC cookie (transition). Prefer ADMIN_ACCESS_CODE.
# DASHBOARD_PASSWORD=choose-a-strong-password
# DASHBOARD_SECRET=optional-random-string

# Local only — skip auth when password unset
# DASHBOARD_OPEN=true

# Onboarding + Pronunciation studio (Use this take audio verify)
# Without this key, desk still saves pack targets with a basic local say-as.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override for audio-capable model used by pronunciation verify:
# GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite

# Staff ops mail on Admin → Platform. Not owner leads.
# RESEND_API_KEY=re_...
# OPS_EMAIL_FROM=Scalers ops <platform@ops.scalers.co.ke>
# SCALERS_OPS_ALERT_EMAILS=you@scalers.co.ke
# CRON_SECRET= (16+ characters; bearer for GET /api/cron/ops-alerts. Unset refuses the route.)
# OPS_ALERTS_DRY_RUN=true
# OPS_WALLET_ALERT_THRESHOLDS_KES=500,100
# OPS_ALERTS_REARM_MARGIN=0.10
# Staging phone wallet, read from prod Desk (staging Desk never mails). wallet.read-only key.
# SAUTIKIT_STAGING_WALLET_KEY=
# OPS_STAGING_WALLET_ALERT_THRESHOLDS_KES=300
# OPS_ALERTS_STALE_HOURS=6
# OPS_SMS_CREDIT_WARN_BELOW=100
# OPS_SMS_CREDIT_CRITICAL_AT=20
# Staging or preview only. Ignored when VERCEL_ENV=production.
# OPS_ALERTS_SIMULATE_WALLET_MINOR=
# OPS_ALERTS_SIMULATE_SMS_CREDIT=

# Super Admin telecom panel + DID pool sync (server-only, never NEXT_PUBLIC_*)
# SAUTIKIT_API_KEY=your_sautikit_api_key
# SAUTIKIT_API_BASE=https://api.sautikit.com
# Key B — buy numbers + set routing (numbers.claim). Keep separate from Key A.
# SAUTIKIT_ADMIN_OPS_KEY=your_admin_ops_key
# Railway voice engine public URL (include https:// — host-only values break preview)
# VOICE_PUBLIC_BASE_URL=https://scalers-project-production.up.railway.app
# Must match Railway exactly (desk phone preview + DID webhook routing)
# VOICE_INTERNAL_SECRET=

# One-wallet billing display rates (optional; inbound 0 / outbound 4 / line 1000)
# WALLET_RATE_KES_PER_MINUTE=0
# NEXT_PUBLIC_WALLET_RATE_KES_PER_MINUTE=0
# WALLET_TRANSFER_RATE_KES_PER_MINUTE=4
# WALLET_LINE_FEE_KES_PER_MONTH=1000

# Desk sign-up: open (default) keeps self sign-up; request shows Request access at /signup.
# SIGNUP_MODE=request
# Super Admin v2: access request queue at /admin/access-requests
# ADMIN_V2=true
# Email when someone submits Request access (uses RESEND_API_KEY + ALERT_EMAIL_FROM)
# ACCESS_REQUEST_NOTIFY_EMAIL=you@example.com

# Staff WhatsApp alerts are live. Set 0 to hide the desk toggle.
# NEXT_PUBLIC_NOTIFY_WHATSAPP_AVAILABLE=true
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
# PAYSTACK_SECRET_KEY=

# Invoice pay. Off uses the mock and sends no money. Never commit a key.
# Staging and Preview: BACHS_MODE=sandbox, plus the sandbox key and webhook secret.
# Production live mode also needs BACHS_LIVE_ALLOWED=true.
# In live mode an unset, empty, or whitespace BACHS_LIVE_TENANT_ALLOWLIST refuses every business.
# A comma-separated list allows those tenant ids. * is the only value that allows every business.
# BACHS_MODE=off
# BACHS_LIVE_ALLOWED=
# BACHS_LIVE_TENANT_ALLOWLIST=
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# Unreadable Bachs reads are retried by GET /api/cron/billing-payment-retry.
# The route is not scheduled. When it is, the caller sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=
# Billing notices stay queued until this is on. Off is the default. Sending uses the existing notify path.
# BILLING_NOTICES_SEND=

# Plan and seat changes stay closed until the Ops RPC is wired.
# DESK_PLAN_CHANGE=on

# Business Assistant facts rollout (on only when exactly on).
# DESK_ATTEST_SERVICE_AREAS=on
# FACT_PAYMENTS_V2_HASH=on
# FACT_SAVE_IS_CONFIRM=on
# DESK_ASSISTANT_SAY_PAGE=on
# VOICE_FALLBACK_BY_KIND=on
# DESK_LOOKUP_PREVIEW=on

# Phone alerts: same public key as the voice server's VAPID_PUBLIC_KEY. Unset = honest "not ready" card.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The subscribe API writes push_subscriptions with SUPABASE_SERVICE_ROLE_KEY (already set).
# Make keys once with `npx web-push generate-vapid-keys`; runbook: docs/reference/platform/DESK_PWA_PUSH.md.
