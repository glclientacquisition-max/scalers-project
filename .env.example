# =============================================================================
# Voice engine — SautiKit webhook + Supabase (Phase 2)
# =============================================================================

PORT=3000

# --- Supabase (required) ---
# Project URL only — do NOT append /rest/v1/
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: pin calls to a tenant when DID lookup is not used
# TENANT_ID=
# Live SautiKit DID (used for WebRTC caller/callee flip detection)
# SAUTIKIT_DID=+254709221536
# SUPABASE_RECORDINGS_BUCKET=call-recordings

# --- One-wallet billing (KES prepaid) ---
# Apply docs/supabase/one_wallet_billing.sql first.
# WALLET_CHARGING_ENABLED=true
# WALLET_RATE_KES_PER_MINUTE=15
# WALLET_LINE_FEE_KES_PER_MONTH=1000

# Optional public HTTPS URL. Not required for SautiKit Stream —
# /voice/incoming builds wss:// from the request Host header (Localtunnel).
# PUBLIC_BASE_URL=https://your-localtunnel-url.loca.lt

# Optional until LLM turns are enabled on the media path
# GEMINI_API_KEY=YOUR_API_KEY
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MAX_RETRIES=3

# Business profile overrides (optional — tenants.llm_system_prompt wins when set)
# BUSINESS_NAME=Jirani Home Services
# BUSINESS_KNOWLEDGE=Plumbing, electrical, cleaning in Nairobi. Hours Mon-Sat 8-6.

# Optional owner notify destination (fallback if tenants.whatsapp_notification_number empty)
# BUSINESS_OWNER_WHATSAPP_NUMBER=+2547XXXXXXXX

# Email alert fallback (Resend) — used when WhatsApp is not ready or send fails
# RESEND_API_KEY=re_...
# ALERT_EMAIL_FROM=Scalers Alerts <alerts@yourdomain.com>
# OWNER_ALERT_EMAIL=fallback@yourdomain.com

# =============================================================================
# SautiKit (production cutover)
# =============================================================================
# SAUTIKIT_API_KEY=
# SAUTIKIT_API_BASE=https://api.sautikit.com
# SAUTIKIT_WEBHOOK_SECRET=
# SAUTIKIT_VOICE_SIGNING_SECRET=
# SAUTIKIT_VALIDATE_WEBHOOKS=false
# WhatsApp alerts (plug-and-play): set these and per-tenant owner/teammate numbers.
# When configured, WhatsApp is preferred automatically; email is the fallback.
# SAUTIKIT_WHATSAPP_NUMBER_ID=
# SAUTIKIT_WHATSAPP_CONNECTION_ID=
# SAUTIKIT_WHATSAPP_TEMPLATE=missed_call_lead
# SAUTIKIT_WHATSAPP_TEMPLATE_LANG=en

# =============================================================================
# Speech / Soniox
# =============================================================================
SONIOX_API_KEY=your_soniox_api_key
# TTS uses the Scalers cloned voice (fixed in code). SONIOX_VOICE is ignored.
# Scalers cloned voice id: 7b197f3c-84b4-4404-986f-114e4dac1432
# Optional shared secret for desk → voice /api/tts/preview (set same on Railway + Vercel)
# VOICE_INTERNAL_SECRET=
# SONIOX_TTS_LANGUAGE=en
# SONIOX_STT_MODEL=stt-rt-v5
# SONIOX_SAMPLE_RATE=16000
# Greeting: instant (default, correct business name, no Gemini wait) | gemini
# VOICE_GREETING_MODE=instant
# VOICE_GREETING=
# VOICE_GREETING_TIMEOUT_MS=700
# While Gemini thinks: auto (default — ack only if first audio is slow) | ack | off | custom text
# VOICE_FILLER=auto
# VOICE_FILLER_DELAY_MS=400
# Stream Gemini tokens into Soniox TTS (on|off). on = first audio before full reply.
# VOICE_LLM_STREAM=on
# Early first-audio from streamed LLM text (clause / word window)
# VOICE_STREAM_EARLY_CHARS=18
# VOICE_STREAM_EARLY_WORDS=5
# GEMINI_THINKING_LEVEL=MINIMAL
# GEMINI_MAX_OUTPUT_TOKENS=120
# GEMINI_VOICE_TEMPERATURE=0.35
# SONIOX_TTS_SPEED=1.02
# Optional per-language pacing (Swahili often clearer a touch slower)
# SONIOX_TTS_SPEED_SW=0.98
# SONIOX_TTS_SPEED_EN=1.02
# Turn-taking / endpointing (Soniox + local adaptive flush)
# SONIOX_MAX_ENDPOINT_DELAY_MS=700
# SONIOX_ENDPOINT_SENSITIVITY=0.5
# SONIOX_ENDPOINT_LATENCY_ADJ=2
# Per-tenant STT vocabulary (business/services/places) — on by default; off for A/B
# SONIOX_STT_CONTEXT=on
# SONIOX_STT_CONTEXT_MAX_TERMS=40
# SONIOX_STT_CONTEXT_WAIT_MS=800
# VOICE_FLUSH_MIN_MS=300
# VOICE_FLUSH_MAX_MS=1200
# Barge-in: grace after TTS start; early window needs stronger interrupt signal
# VOICE_BARGE_GRACE_MS=200
# VOICE_BARGE_EARLY_MS=800
# VOICE_BARGE_MIN_CHARS=5
# See docs/agents/VOICE_SPEED_CONSISTENCY.md for the speed/consistency plan.
# Barge-in uses accumulated interim STT + drachtio `{ type: "killAudio" }` clear.
# Global TTS lexicon overrides (JSON array). Tenant tenants.tts_lexicon wins on same match.
# TTS_LEXICON_OVERRIDES=[{"match":"wanjiku","say":"Wan-jee-koo"}]
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=
