# =============================================================================
# Voice engine — Twilio ConversationRelay + Gemini + Supabase
# =============================================================================

TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
GEMINI_API_KEY=YOUR_API_KEY
# Set to false only for local webhook testing without Twilio signatures.
TWILIO_VALIDATE_WEBHOOKS=true

# Public URL Twilio / SautiKit can reach — ngrok while developing,
# real domain in production. No trailing slash.
PUBLIC_BASE_URL=https://your-domain-or-ngrok-subdomain.ngrok.app

PORT=3000

# --- Supabase (required) ---
# Project URL only — do NOT append /rest/v1/
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: pin calls to a tenant when DID lookup is not used
# TENANT_ID=
# SUPABASE_RECORDINGS_BUCKET=call-recordings

# --- WhatsApp lead notification ---
# Twilio number provisioned for WhatsApp (E.164, NO "whatsapp:" prefix —
# the code adds that). For testing you can use Twilio's WhatsApp sandbox
# number; for production this must be an approved WhatsApp Business sender.
TWILIO_WHATSAPP_FROM=+14155238886

# Business owner's WhatsApp-reachable number (E.164, NO "whatsapp:" prefix).
BUSINESS_OWNER_WHATSAPP_NUMBER=+15551234567

# =============================================================================
# Later phases (SautiKit / Soniox) — not wired yet
# =============================================================================
# TELEPHONY_PROVIDER=twilio
# SAUTIKIT_API_KEY=
# SAUTIKIT_WEBHOOK_SECRET=
# SONIOX_API_KEY=
# LLM_PROVIDER=gemini
# OPENAI_API_KEY=
